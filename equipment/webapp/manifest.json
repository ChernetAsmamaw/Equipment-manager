{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.fe.demo.equipment",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.18.0",
      "toolsId": "846da0b2-b3ca-4b51-b094-a8a2897c20be"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsb_equipment_ca/srvd/sap/zsd_equipment_ca/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.133.4",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sap.fe.demo.equipment.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "EquipmentList",
          "target": "EquipmentList"
        },
        {
          "pattern": "Equipment({key}):?query:",
          "name": "EquipmentObjectPage",
          "target": "EquipmentObjectPage"
        },
        {
          "pattern": "Equipment({key})/_MaintenanceTasks({key2}):?query:",
          "name": "MaintenanceTaskObjectPage",
          "target": "MaintenanceTaskObjectPage"
        }
      ],
      "targets": {
        "EquipmentList": {
          "type": "Component",
          "id": "EquipmentList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Equipment",
              "variantManagement": "Page",
              "navigation": {
                "Equipment": {
                  "detail": {
                    "route": "EquipmentObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "EquipmentObjectPage": {
          "type": "Component",
          "id": "EquipmentObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Equipment",
              "navigation": {
                "_MaintenanceTasks": {
                  "detail": {
                    "route": "MaintenanceTaskObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "_MaintenanceTasks/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "CustomWorkflowAction": {
                      "press": "sap.fe.demo.equipment.ext.CustomActions.onWorkflowButtonPress",
                      "text": "Workflow",
                      "requiresSelection": true,
                      "enabled": "{= ${ui>/getSelectionContexts}.length > 0 }"
                    }
                  }
                }
              }
            }
          }
        },
        "MaintenanceTaskObjectPage": {
          "type": "Component",
          "id": "MaintenanceTaskObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Equipment/_MaintenanceTasks"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}